# ------------------------------------------------------------------
# Bu dosyayı ".env" adıyla kopyalayın:  cp .env.example .env
# .env dosyası GitHub'a ASLA commit edilmez (.gitignore içinde).
# Binance şifrenizi buraya YAZMAYIN; yalnızca API Key ve Secret gerekir.
# API anahtarında "Enable Withdrawals" (para çekme) KAPALI olmalıdır.
# ------------------------------------------------------------------
# --- Binance Global (binance.com) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Binance TR (binance.tr) ---
BINANCE_TR_API_KEY=
BINANCE_TR_API_SECRET=

# Botun İŞLEM yapacağı borsa: BINANCE_GLOBAL veya BINANCE_TR
# (anahtarı girilen diğer hesap panelde sadece görüntülenir)
TRADING_EXCHANGE=BINANCE_GLOBAL
# İşlem para birimi: Global için USDT, Binance TR için otomatik TRY
# QUOTE_ASSET=

TRADING_MODE=DRY_RUN

# --- Opsiyonel ayarlar (varsayılanlar güvenli başlangıç içindir) ---
# BINANCE_TESTNET=false
# AUTO_START=true
# ALLOW_LIVE_AUTO_START=false
# DRY_RUN_START_BALANCE=1000
# PANEL_TOKEN=
# PANEL_HOST=127.0.0.1
# PANEL_PORT=8000
# DATABASE_URL=sqlite:///./data/bot.db

# --- Risk profili ---
# MAX_POSITION_PCT=0.20
# MAX_OPEN_POSITIONS=1
# RISK_PER_TRADE_PCT=0.01
# MAX_DAILY_LOSS_PCT=0.03
# MAX_DAILY_TRADES=5
# MAX_CONSECUTIVE_LOSSES=3
# COOLDOWN_HOURS=12
# MIN_OPPORTUNITY_SCORE=75

# --- Tarama ve rotasyon ---
# MIN_QUOTE_VOLUME_USDT=20000000   (Binance TR varsayılanı: 1000000)
# MAX_SPREAD_PCT=0.0015
# SYMBOL_BLACKLIST=
# ROTATION_ENABLED=true
# ROTATION_MIN_SCORE_DIFF=15
# MANAGE_EXISTING_HOLDINGS=false
